#!/usr/bin/env bash
set -euo pipefail

remote_name="${1:-}"
remote_url="${2:-}"
repo_root="$(git rev-parse --show-toplevel)"
zeros="0000000000000000000000000000000000000000"

fail() {
  echo "pre-push rejected: $1" >&2
  exit 1
}

require_matching_cr_record() {
  local remote_name="$1"
  local remote_sha="$2"
  local local_sha="$3"
  local short_local_sha
  local short_remote_sha=""
  local head_or_range
  local file
  local ref
  local -a topic_refs=()

  short_local_sha="$(git rev-parse --short "$local_sha")"
  if [ "$remote_sha" != "$zeros" ]; then
    short_remote_sha="$(git rev-parse --short "$remote_sha")"
  fi

  while IFS= read -r ref; do
    [ -n "$ref" ] || continue
    ref="${ref#${remote_name}/}"
    [ "$ref" = "main" ] && continue
    topic_refs+=("$ref")
  done < <(
    git for-each-ref --contains "$local_sha" --format='%(refname:short)' "refs/remotes/${remote_name}"
  )

  for file in cr/CR-*.md; do
    [ -e "$file" ] || break
    head_or_range="$(sed -n 's/^Head or Range: //p' "$file")"

    printf '%s\n' "$head_or_range" | grep -Fq "$local_sha" && return 0
    printf '%s\n' "$head_or_range" | grep -Fq "$short_local_sha" && return 0

    if [ -n "$short_remote_sha" ]; then
      printf '%s\n' "$head_or_range" | grep -Fq "$remote_sha..$local_sha" && return 0
      printf '%s\n' "$head_or_range" | grep -Fq "$short_remote_sha..$short_local_sha" && return 0
    fi

    for ref in "${topic_refs[@]}"; do
      printf '%s\n' "$head_or_range" | grep -Fq "$ref" && return 0
    done
  done

  fail "main integration with UGS_ALLOW_MAIN_PUSH=cr requires a matching cr/CR-*.md record"
}

cd "$repo_root"

scripts/validate_repo.sh

git diff --quiet || fail "working tree must be clean before push"
git diff --cached --quiet || fail "index must be clean before push"

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue

  if [ "$local_sha" = "$zeros" ]; then
    case "$remote_ref" in
      refs/heads/main)
        fail "deleting main is not allowed"
        ;;
      refs/tags/v*)
        fail "deleting formal release tags is not allowed"
        ;;
    esac
    continue
  fi

  case "$remote_ref" in
    refs/heads/main)
      if [ "${UGS_ALLOW_MAIN_PUSH:-}" = "bootstrap" ]; then
        :
      elif [ "${UGS_ALLOW_MAIN_PUSH:-}" = "cr" ]; then
        git merge-base --is-ancestor "$remote_sha" "$local_sha" || fail "main integration must be fast-forward"
        git for-each-ref --contains "$local_sha" --format='%(refname:short)' "refs/remotes/${remote_name}" \
          | grep -Ev "^${remote_name}/main$" >/dev/null \
          || fail "push the topic branch first before integrating main with UGS_ALLOW_MAIN_PUSH=cr"
        require_matching_cr_record "$remote_name" "$remote_sha" "$local_sha"
      elif [ "${UGS_ALLOW_MAIN_PUSH:-}" = "emergency" ] && [ -n "${UGS_EMERGENCY_REASON:-}" ]; then
        :
      else
        fail "direct pushes to main are blocked; push a topic branch and merge through a CR"
      fi
      ;;
    refs/tags/v*)
      object_type="$(git cat-file -t "$local_sha")"
      [ "$object_type" = "tag" ] || fail "formal release tags must be annotated"
      git -c gpg.format=ssh \
        -c gpg.ssh.allowedSignersFile="$repo_root/keys/allowed_signers" \
        -c gpg.ssh.revocationFile="$repo_root/keys/revoked_signers" \
        verify-tag "$local_sha" >/dev/null 2>&1 \
        || fail "formal release tags must be signed by a trusted signer"
      ;;
  esac

  if [ "$remote_sha" = "$zeros" ]; then
    while IFS= read -r commit; do
      tmp_file="$(mktemp)"
      trap 'rm -f "$tmp_file"' EXIT
      git log -1 --format=%B "$commit" > "$tmp_file"
      scripts/validate_commit_message.sh "$tmp_file"
      scripts/validate_commit_signatures.sh "$commit"
      rm -f "$tmp_file"
      trap - EXIT
    done < <(git rev-list --reverse "$local_sha" --not --remotes="${remote_name}")
  else
    scripts/validate_commit_range.sh "$remote_sha..$local_sha"
    scripts/validate_commit_signatures.sh "$remote_sha..$local_sha"
  fi
done
